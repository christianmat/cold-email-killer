{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["google-apps-script", "node"],
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src", "test", "scripts"]
}
